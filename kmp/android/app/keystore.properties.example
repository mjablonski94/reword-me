# Release signing. Copy to keystore.properties (git-ignored) next to this
# file and fill in your values; without it, release builds fall back to the
# debug key so every clone still assembles.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.keystore -alias rewordme \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to android/app/.
storeFile=release.keystore
storePassword=changeit
keyAlias=rewordme
keyPassword=changeit
