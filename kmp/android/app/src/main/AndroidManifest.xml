<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RewordMeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RewordMe">

        <activity
            android:name=".features.home.presentation.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- singleTop so a double-tap on the Settings pill cannot stack two
             instances on the back stack. -->
        <activity
            android:name=".features.settings.presentation.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- The entry other apps show in their text-selection menu. Its label
             is the user-facing "Reword me"; the host EditText replaces the
             selection with EXTRA_PROCESS_TEXT from our activity result. -->
        <activity
            android:name=".features.popup.presentation.ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/android_processText"
            android:theme="@style/Theme.RewordMe.Popup"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
